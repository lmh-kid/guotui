# syntax=docker/dockerfile:1
# __APP_NAME__ — Next.js（可选自定义 server，如 tsup 打包的 dist/server.js）
# 参数占位符由 docker-deploy-aliyun Skill 渲染，不要手动改占位符

FROM __NODE_IMAGE__ AS builder
ENV NEXT_TELEMETRY_DISABLED=1 \
    CI=1 \
    NODE_OPTIONS=--max-old-space-size=4096
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@__PNPM_VERSION__ --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN __BUILD_CMD__

FROM __NODE_IMAGE__ AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    TZ=__TZ__ \
    PORT=__CONTAINER_PORT__
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@__PNPM_VERSION__ --activate
COPY package.json pnpm-lock.yaml ./
# pnpm 的 node_modules 是符号链接结构，必须整目录安装/复制，不能挑单个包
RUN pnpm install --prod --frozen-lockfile --ignore-scripts
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.ts ./next.config.ts
COPY --from=builder /app/tsconfig.json ./tsconfig.json

EXPOSE __CONTAINER_PORT__
CMD __START_CMD__
